# Copy this file to ".env" and fill in your own values.  NEVER commit ".env".

# REQUIRED for real use: a long random string used to sign login sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# The first administrator account, created automatically on first start.
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=ChangeThisPassword123

# Optional settings
# DATABASE=database.db
# FLASK_DEBUG=1
# DISPLAY_UTC_OFFSET_MINUTES=330   # 330 = India (IST). Times are stored in UTC.
# SESSION_COOKIE_SECURE=1          # set to 1 only when served over HTTPS
